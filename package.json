{
  "name": "queener",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "web:dev": "bun run --filter @queener/web dev",
    "web:build": "bun run --filter @queener/web build",
    "web:preview": "bun run --filter @queener/web preview",
    "web:test:unit": "bun run --filter @queener/web test:unit",
    "web:prepare": "bun run --filter @queener/web prepare",
    "web:test:e2e": "bun run --filter @queener/web test:e2e",
    "web:test:e2e:dev": "bun run --filter @queener/web test:e2e:dev",
    "web:build-only": "bun run --filter @queener/web build-only",
    "web:type-check": "bun run --filter @queener/web type-check",
    "web:lint": "bun run --filter @queener/web lint",
    "web:format": "bun run --filter @queener/web format"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.0.0"
}
